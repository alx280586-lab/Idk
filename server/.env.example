# Copy this file to `.env` and adjust values for your environment.
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
RADAR_TILE_BASE_URL=https://opengeo.ncep.noaa.gov/geoserver/conus/{product}/wms
RADAR_PRODUCT_REFLECTIVITY=conus_bref_qcd
RADAR_PRODUCT_VELOCITY=conus_vel_max
RADAR_PRODUCT_CC=conus_cc
RADAR_PRODUCT_ECHOTOPS=conus_etop35
NWS_WARNINGS_URL=https://api.weather.gov/alerts/active?status=actual&message_type=alert
WARNINGS_UPDATE_INTERVAL_MS=60000
RADAR_FRAME_COUNT=12
RADAR_FRAME_INTERVAL_MINUTES=5
